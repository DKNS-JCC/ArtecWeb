# ── Backend ───────────────────────────────────────────
PORT=3000
JWT_SECRET=change-me-to-a-random-string

# Gmail SMTP (used to send welcome emails to new staff)
# Generate an App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# URL shown in welcome emails (points to the frontend login page)
APP_URL=http://localhost:5173/login

# Gemini AI (chat command interpretation for visitor-robot interaction)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Frontend (prefix with VITE_) ─────────────────────
VITE_API_URL=http://localhost:3000/api
