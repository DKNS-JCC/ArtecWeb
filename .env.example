PORT=3000
JWT_SECRET=

#App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Cambiar por IP local del server
APP_URL=http://localhost:5173/login

#Gemini y modelo https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# STT
#   Xenova/whisper-tiny -> malo
#   Xenova/whisper-base -> mejor
WHISPER_MODEL=Xenova/whisper-tiny
WHISPER_LANGUAGE=spanish

# Puerto del backend
VITE_API_URL=http://localhost:3000/api

# Solo desarrollo: permite crear una sesión de visitante y probar el chat sin un
# robot conectado a ROS. NO activar en producción. Déjalo vacío o quítalo para el despliegue.
ALLOW_OFFLINE_VISITOR=
