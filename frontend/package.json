{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "cross-env VITE_HTTPS=1 vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:https": "cross-env VITE_HTTPS=1 vite preview",
    "docs": "npm run docs:generate",
    "docs:generate": "jsdoc -c jsdoc.json",
    "docs:serve": "node scripts/serve-docs.mjs",
    "docs:jsdoc": "jsdoc -c jsdoc.json",
    "docs:components": "vue-docgen -c docgen.config.cjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@vueuse/core": "^12.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "roslib": "^2.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.25",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "cross-env": "^10.1.0",
    "docdash": "^2.0.2",
    "jsdoc": "^4.0.5",
    "vite": "^7.3.1",
    "vue-docgen-cli": "^4.79.0"
  }
}
